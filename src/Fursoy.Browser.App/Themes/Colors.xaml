<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!--
        FURSOY Browser renk paleti.

        Tasarım dili: Fluent (Windows 11 / Edge) taban + yumuşak kabartma
        (neumorphism) dokunuşları. Net kontrast ve katmanlı, ince kenarlıklı
        yüzeyler Fluent'ten; hover/aktif durumlarda görülen yumuşak dış/iç
        gölgeler neumorphism'den gelir — ama hiçbir yerde neumorphism'in tek
        tonlu düşük kontrast tuzağına düşülmez, metin/ikon rengi zeminden
        her zaman net ayrışır.

        Tek vurgu (accent) rengi: #13ABBB. Bu renk yalnızca vurgu/etkileşim
        noktalarında (aktif sekme çizgisi, odaklı adres çubuğu kenarlığı,
        birincil buton, hover/seçim işaretleri) kullanılır — asla büyük bir
        arka plan alanını doldurmaz. Zemin her zaman siyah/koyu gri tonlardır.

        Yeni bir renk eklemeden önce burada tanımlı bir tonun yeniden
        kullanılıp kullanılamayacağı değerlendirilmeli.
    -->

    <Color x:Key="AccentColor">#13ABBB</Color>
    <Color x:Key="AccentColorHover">#17C4D6</Color>
    <Color x:Key="AccentColorPressed">#0F8998</Color>

    <!--
        Bu tonlar TAHMİN DEĞİL, Chrome'un kendi koyu tema tanımlarından
        birebir alınmıştır (chrome_color_mixer.cc / tab_strip_color_mixer.cc /
        omnibox_color_mixer.cc / ui_color_mixer.cc):

          kColorFrameActive        = Google Grey 900 = #202124
              → sekme şeridi + başlık çubuğu zemini
          kColorToolbar            = #35363A
              → araç çubuğu VE aktif sekme (aynı token, bu yüzden aktif
                sekme araç çubuğuna kesintisiz akar)
          kColorTabBackgroundInactiveFrameActive = kColorFrameActive
              → pasif sekmenin kendi dolgusu YOKTUR, şerit rengiyle aynıdır
          kColorLocationBarBackground = Google Grey 900 = #202124
              → adres çubuğu araç çubuğundan DAHA KOYUdur (daha açık değil);
                gömük görünmesi Chrome'un ayırt edici detayıdır

        Vurgu rengi (#13ABBB) bize ait tek sapmadır; renk paleti dışındaki
        hiçbir şey uydurulmaz, gerekiyorsa yukarıdaki kaynaklardan bakılır.
    -->
    <!-- Chrome 2026 koyu teması; kullanıcının 1920 px referansından piksel örnekleri. -->
    <Color x:Key="BackgroundColor">#1C2027</Color>
    <Color x:Key="SurfaceColor">#383B43</Color>
    <Color x:Key="SurfaceHoverColor">#3B475E</Color>
    <Color x:Key="SurfaceAltColor">#23262D</Color>
    <Color x:Key="SurfacePressedColor">#303B50</Color>
    <!-- Omnibox kenarlığı: siyahın %30 opaklığı (kColorLocationBarBorder) -->
    <Color x:Key="BorderColor">#4D000000</Color>
    <!-- Sekme ayracı Chrome'da metin renginin soluk bir tonudur -->
    <Color x:Key="TabSeparatorColor">#383B43</Color>
    <Color x:Key="WindowBorderColor">#4A4E57</Color>

    <!-- Fluent katman çizgisi: yüzeylerin üst kenarında ince, yarı saydam bir "rim light". -->
    <Color x:Key="HighlightRimColor">#14FFFFFF</Color>

    <!-- Neumorphism dokunuşu: hover/aktif durumlarda kullanılan yumuşak dış gölge. -->
    <Color x:Key="SoftShadowColor">#000000</Color>
    <DropShadowEffect x:Key="PopupElevationEffect" Color="#000000"
                      Direction="270" ShadowDepth="5" BlurRadius="20" Opacity="0.48" />

    <Color x:Key="TextPrimaryColor">#E4E2E3</Color>
    <Color x:Key="TextSecondaryColor">#C4C6D0</Color>
    <Color x:Key="TextOnAccentColor">#000000</Color>
    <Color x:Key="OmniboxUrlColor">#A8C7FA</Color>
    <Color x:Key="OmniboxSelectionColor">#4C8BF5</Color>
    <Color x:Key="DestructiveColor">#F28B82</Color>

    <SolidColorBrush x:Key="AccentBrush" Color="{DynamicResource AccentColor}" />
    <SolidColorBrush x:Key="AccentHoverBrush" Color="{DynamicResource AccentColorHover}" />
    <SolidColorBrush x:Key="AccentPressedBrush" Color="{DynamicResource AccentColorPressed}" />

    <SolidColorBrush x:Key="BackgroundBrush" Color="{DynamicResource BackgroundColor}" />
    <SolidColorBrush x:Key="SurfaceBrush" Color="{DynamicResource SurfaceColor}" />
    <SolidColorBrush x:Key="TabSeparatorBrush" Color="{DynamicResource TabSeparatorColor}" />
    <SolidColorBrush x:Key="WindowBorderBrush" Color="{DynamicResource WindowBorderColor}" />
    <SolidColorBrush x:Key="SurfaceHoverBrush" Color="{DynamicResource SurfaceHoverColor}" />
    <SolidColorBrush x:Key="SurfaceAltBrush" Color="{DynamicResource SurfaceAltColor}" />
    <SolidColorBrush x:Key="SurfacePressedBrush" Color="{DynamicResource SurfacePressedColor}" />
    <SolidColorBrush x:Key="BorderBrush" Color="{DynamicResource BorderColor}" />
    <SolidColorBrush x:Key="HighlightRimBrush" Color="{DynamicResource HighlightRimColor}" />

    <SolidColorBrush x:Key="TextPrimaryBrush" Color="{DynamicResource TextPrimaryColor}" />
    <SolidColorBrush x:Key="TextSecondaryBrush" Color="{DynamicResource TextSecondaryColor}" />
    <SolidColorBrush x:Key="TextOnAccentBrush" Color="{DynamicResource TextOnAccentColor}" />
    <SolidColorBrush x:Key="OmniboxUrlBrush" Color="{DynamicResource OmniboxUrlColor}" />
    <SolidColorBrush x:Key="OmniboxSelectionBrush" Color="{DynamicResource OmniboxSelectionColor}" />
    <SolidColorBrush x:Key="DestructiveBrush" Color="{DynamicResource DestructiveColor}" />

</ResourceDictionary>
