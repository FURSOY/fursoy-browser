<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!--
        FURSOY Browser renk paleti.

        Tasarım dili: Fluent (Windows 11 / Edge) taban + yumuşak kabartma
        (neumorphism) dokunuşları. Net kontrast ve katmanlı, ince kenarlıklı
        yüzeyler Fluent'ten; hover/aktif durumlarda görülen yumuşak dış/iç
        gölgeler neumorphism'den gelir — ama hiçbir yerde neumorphism'in tek
        tonlu düşük kontrast tuzağına düşülmez, metin/ikon rengi zeminden
        her zaman net ayrışır.

        Tek vurgu (accent) rengi: #13ABBB. Bu renk yalnızca vurgu/etkileşim
        noktalarında (aktif sekme çizgisi, odaklı adres çubuğu kenarlığı,
        birincil buton, hover/seçim işaretleri) kullanılır — asla büyük bir
        arka plan alanını doldurmaz. Zemin her zaman siyah/koyu gri tonlardır.

        Yeni bir renk eklemeden önce burada tanımlı bir tonun yeniden
        kullanılıp kullanılamayacağı değerlendirilmeli.
    -->

    <Color x:Key="AccentColor">#13ABBB</Color>
    <Color x:Key="AccentColorHover">#17C4D6</Color>
    <Color x:Key="AccentColorPressed">#0F8998</Color>

    <!--
        Bu tonlar TAHMİN DEĞİL, Chrome'un kendi koyu tema tanımlarından
        birebir alınmıştır (chrome_color_mixer.cc / tab_strip_color_mixer.cc /
        omnibox_color_mixer.cc / ui_color_mixer.cc):

          kColorFrameActive        = Google Grey 900 = #202124
              → sekme şeridi + başlık çubuğu zemini
          kColorToolbar            = #35363A
              → araç çubuğu VE aktif sekme (aynı token, bu yüzden aktif
                sekme araç çubuğuna kesintisiz akar)
          kColorTabBackgroundInactiveFrameActive = kColorFrameActive
              → pasif sekmenin kendi dolgusu YOKTUR, şerit rengiyle aynıdır
          kColorLocationBarBackground = Google Grey 900 = #202124
              → adres çubuğu araç çubuğundan DAHA KOYUdur (daha açık değil);
                gömük görünmesi Chrome'un ayırt edici detayıdır

        Vurgu rengi (#13ABBB) bize ait tek sapmadır; renk paleti dışındaki
        hiçbir şey uydurulmaz, gerekiyorsa yukarıdaki kaynaklardan bakılır.
    -->
    <Color x:Key="BackgroundColor">#202124</Color>
    <Color x:Key="SurfaceColor">#35363A</Color>
    <Color x:Key="SurfaceHoverColor">#2B2C30</Color>
    <Color x:Key="SurfaceAltColor">#202124</Color>
    <Color x:Key="SurfacePressedColor">#1A1B1D</Color>
    <!-- Omnibox kenarlığı: siyahın %30 opaklığı (kColorLocationBarBorder) -->
    <Color x:Key="BorderColor">#4D000000</Color>
    <!-- Sekme ayracı Chrome'da metin renginin soluk bir tonudur -->
    <Color x:Key="TabSeparatorColor">#5F6368</Color>

    <!-- Fluent katman çizgisi: yüzeylerin üst kenarında ince, yarı saydam bir "rim light". -->
    <Color x:Key="HighlightRimColor">#14FFFFFF</Color>

    <!-- Neumorphism dokunuşu: hover/aktif durumlarda kullanılan yumuşak dış gölge. -->
    <Color x:Key="SoftShadowColor">#000000</Color>

    <Color x:Key="TextPrimaryColor">#F2F2F2</Color>
    <Color x:Key="TextSecondaryColor">#9A9C9E</Color>
    <Color x:Key="TextOnAccentColor">#000000</Color>

    <SolidColorBrush x:Key="AccentBrush" Color="{StaticResource AccentColor}" />
    <SolidColorBrush x:Key="AccentHoverBrush" Color="{StaticResource AccentColorHover}" />
    <SolidColorBrush x:Key="AccentPressedBrush" Color="{StaticResource AccentColorPressed}" />

    <SolidColorBrush x:Key="BackgroundBrush" Color="{StaticResource BackgroundColor}" />
    <SolidColorBrush x:Key="SurfaceBrush" Color="{StaticResource SurfaceColor}" />
    <SolidColorBrush x:Key="TabSeparatorBrush" Color="{StaticResource TabSeparatorColor}" />
    <SolidColorBrush x:Key="SurfaceHoverBrush" Color="{StaticResource SurfaceHoverColor}" />
    <SolidColorBrush x:Key="SurfaceAltBrush" Color="{StaticResource SurfaceAltColor}" />
    <SolidColorBrush x:Key="SurfacePressedBrush" Color="{StaticResource SurfacePressedColor}" />
    <SolidColorBrush x:Key="BorderBrush" Color="{StaticResource BorderColor}" />
    <SolidColorBrush x:Key="HighlightRimBrush" Color="{StaticResource HighlightRimColor}" />

    <SolidColorBrush x:Key="TextPrimaryBrush" Color="{StaticResource TextPrimaryColor}" />
    <SolidColorBrush x:Key="TextSecondaryBrush" Color="{StaticResource TextSecondaryColor}" />
    <SolidColorBrush x:Key="TextOnAccentBrush" Color="{StaticResource TextOnAccentColor}" />

</ResourceDictionary>
