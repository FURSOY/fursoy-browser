<Window x:Class="Fursoy.Browser.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:shell="clr-namespace:System.Windows.Shell;assembly=PresentationFramework"
        xmlns:res="clr-namespace:Fursoy.Browser.App.Resources"
        Title="{x:Static res:Strings.AppTitle}" Height="800" Width="1200" MinWidth="800" MinHeight="600"
        Background="{StaticResource BackgroundBrush}" Foreground="{StaticResource TextPrimaryBrush}"
        WindowStyle="None" ResizeMode="CanResize">

    <shell:WindowChrome.WindowChrome>
        <shell:WindowChrome CaptionHeight="88" GlassFrameThickness="0" CornerRadius="0"
                             ResizeBorderThickness="5" UseAeroCaptionButtons="False" />
    </shell:WindowChrome.WindowChrome>

    <DockPanel x:Name="RootPanel">
        <!-- Tab strip + window controls -->
        <Grid DockPanel.Dock="Top" Height="44" Background="{StaticResource BackgroundBrush}">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <ScrollViewer Grid.Column="0" HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Disabled">
                <StackPanel Orientation="Horizontal">
                    <ItemsControl x:Name="TabStrip" shell:WindowChrome.IsHitTestVisibleInChrome="True">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <StackPanel Orientation="Horizontal" />
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Border x:Name="TabBorder" Width="200" Height="34" Margin="3,5,0,0" CornerRadius="16"
                                        BorderThickness="0,0,0,3" Style="{StaticResource TabBorderStyle}"
                                        MouseLeftButtonUp="TabBorder_MouseLeftButtonUp" Tag="{Binding}">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="26" />
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Text="{Binding Title}" Grid.Column="0" Margin="14,0,0,0"
                                                   VerticalAlignment="Center" TextTrimming="CharacterEllipsis"
                                                   Foreground="{StaticResource TextPrimaryBrush}" FontSize="12"
                                                   FontWeight="SemiBold" />
                                        <Button Grid.Column="1" Content="&#10005;" Style="{StaticResource TabCloseButtonStyle}"
                                                Click="CloseTabButton_Click" Tag="{Binding}" />
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>

                    <Button Content="+" Style="{StaticResource NewTabButtonStyle}" Margin="6,4,0,0"
                            Click="NewTabButton_Click" />
                </StackPanel>
            </ScrollViewer>

            <StackPanel Grid.Column="1" Orientation="Horizontal">
                <Button Content="&#xE921;" Style="{StaticResource TitleBarButtonStyle}" Click="MinimizeButton_Click" />
                <Button x:Name="MaximizeButton" Content="&#xE922;" Style="{StaticResource TitleBarButtonStyle}" Click="MaximizeButton_Click" />
                <Button Content="&#xE8BB;" Style="{StaticResource TitleBarButtonStyle}" Click="CloseButton_Click" />
            </StackPanel>
        </Grid>

        <!-- Navigation toolbar -->
        <Grid DockPanel.Dock="Top" Height="44" Background="{StaticResource SurfaceBrush}">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <StackPanel Orientation="Horizontal" Grid.Column="0" Margin="8,0" VerticalAlignment="Center">
                <Button Content="&#8592;" Style="{StaticResource ToolbarButtonStyle}" Margin="0,0,6,0" Click="BackButton_Click" />
                <Button Content="&#8594;" Style="{StaticResource ToolbarButtonStyle}" Margin="0,0,6,0" Click="ForwardButton_Click" />
                <Button Content="&#8635;" Style="{StaticResource ToolbarButtonStyle}" Click="ReloadButton_Click" />
            </StackPanel>

            <TextBox x:Name="AddressBar" Grid.Column="1" Margin="6,6,10,6" Style="{StaticResource AddressBarStyle}"
                     KeyDown="AddressBar_KeyDown" />
        </Grid>

        <!-- Active browser host -->
        <Grid x:Name="BrowserHost" />
    </DockPanel>
</Window>
