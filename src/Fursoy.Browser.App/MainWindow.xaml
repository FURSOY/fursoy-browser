<Window x:Class="Fursoy.Browser.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:cefwpf="clr-namespace:CefSharp.Wpf;assembly=CefSharp.Wpf"
        Title="FURSOY Browser" Height="800" Width="1200" MinWidth="800" MinHeight="600"
        Background="#202124">
    <DockPanel>
        <Grid DockPanel.Dock="Top" Background="#2b2d31" Height="44">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <StackPanel Orientation="Horizontal" Grid.Column="0" Margin="6,0">
                <Button x:Name="BackButton" Content="&#8592;" Width="32" Click="BackButton_Click" />
                <Button x:Name="ForwardButton" Content="&#8594;" Width="32" Click="ForwardButton_Click" />
                <Button x:Name="ReloadButton" Content="&#8635;" Width="32" Click="ReloadButton_Click" />
            </StackPanel>

            <TextBox x:Name="AddressBar" Grid.Column="1" VerticalContentAlignment="Center"
                     Margin="4,8" Padding="8,2" KeyDown="AddressBar_KeyDown" />
        </Grid>

        <cefwpf:ChromiumWebBrowser x:Name="Browser" Address="https://www.google.com" />
    </DockPanel>
</Window>
